extends SceneTree

const PreMatchSetup = preload("res://scripts/ui/pre_match_setup.gd")

var selected_mode := ""

func _initialize() -> void:
	call_deferred("_run_tests")

func _run_tests() -> void:
	var hub_script = load("res://scripts/ui/game_hub.gd")
	assert(hub_script != null, "Game hub script must load")
	var hub = hub_script.new()
	root.add_child(hub)
	await process_frame
	assert(hub.current_page == "home", "Hub must open on Home")
	var main_nav = hub.root.get_child(1).get_child(0).get_child(1)
	assert(main_nav.get_child_count() == 4, "All four main screens must remain visible in the primary navigation")
	assert(main_nav.get_child(0).text == "INICIO" and main_nav.get_child(1).text == "⬇ ONLINE" and main_nav.get_child(2).text == "⬇ MODOS" and main_nav.get_child(3).text == "CONFIGURACIÓN", "All four screen destinations must be visible")
	var friendly_requests := [0]
	hub.match_11v11_requested.connect(func(): friendly_requests[0] += 1)
	var home_friendly_panel: Control = hub.content_box.get_child(1)
	var home_friendly_column: Control = home_friendly_panel.get_child(0)
	var friendly_button: Button = home_friendly_column.get_child(2)
	assert(friendly_button.text == "JUGAR AMISTOSO", "Base Home must offer a local friendly match")
	friendly_button.pressed.emit()
	assert(friendly_requests[0] == 1, "Friendly action must request a local 11v11 match")

	var pre_match := PreMatchSetup.new()
	root.add_child(pre_match)
	await process_frame
	assert(pre_match._home_teams.item_count >= 2 and pre_match._away_teams.item_count >= 2, "Friendly preparation must list at least two clubs with valid rosters")
	assert(not pre_match._start_button.disabled, "Friendly preparation must enable start when two valid clubs are selected")
	pre_match._away_teams.select(pre_match._home_teams.selected)
	pre_match._refresh_validation()
	assert(pre_match._start_button.disabled, "Friendly preparation must block selecting the same club twice")
	pre_match._away_teams.select(1 if pre_match._home_teams.selected == 0 else 0)
	pre_match._refresh_validation()
	assert(not pre_match._start_button.disabled, "Friendly preparation must recover when two different valid clubs are selected")
	var selected_friendly: Array = []
	pre_match.match_requested.connect(func(settings: Dictionary): selected_friendly.append(settings))
	pre_match._start_match()
	assert(selected_friendly.size() == 1, "Friendly preparation must emit the validated match configuration")
	if selected_friendly.size() == 1:
		var friendly_settings: Dictionary = selected_friendly[0]
		assert(str(friendly_settings.get("home_team_id", "")) != str(friendly_settings.get("away_team_id", "")), "Friendly preparation must reject the same club on both sides")
		assert(friendly_settings.get("home_player_ids", []).size() == 11 and friendly_settings.get("away_player_ids", []).size() == 11, "Friendly preparation must provide eleven real player IDs per side")
		assert(str(friendly_settings.get("match_type", "")) == "friendly", "Pre-match setup must identify the encounter as a friendly")
	await process_frame

	var home_help_panel: Control = hub.content_box.get_child(2)
	var home_help_column: Control = home_help_panel.get_child(0)
	var help_button: Button = home_help_column.get_child(2)
	help_button.pressed.emit()
	assert(hub.current_subpage == "help", "Help must be available in the base game")
	assert(hub.content_box.get_child_count() == 6, "Help must explain the base game and downloadable modules")
	hub._show_home()
	assert(hub.back_navigation_button != null and hub.back_navigation_button.text == "ATRÁS", "Persistent bottom Back button must exist")
	assert(hub.next_navigation_button != null and hub.next_navigation_button.text == "SIGUIENTE", "Persistent bottom Next button must exist")
	assert(hub.back_navigation_button.disabled, "Back must be disabled on the first main screen")
	hub._navigate_next()
	assert(hub.current_page == "online", "Next must move from Home to Online")
	hub._navigate_back()
	assert(hub.current_page == "home", "Back must return from Online to Home")
	assert(hub.content_box.get_child_count() == 3, "Base Home must show welcome, friendly match and Help only")
	hub._open_main_page("online")
	assert(hub.current_page == "online", "Online main screen must open")
	assert(hub.content_box.get_child_count() == 3, "Online must show network status, custom-player selection and multiplayer status")
	hub._open_main_page("modes")
	assert(hub.current_page == "modes", "Modes main screen must open")
	assert(hub.content_box.get_child_count() == 8, "Modes must list downloadable modules and the module catalogue")
	hub._show_tas_competition()
	assert(hub.current_subpage == "tas", "TAS must open its competition screen")
	assert(hub.content_box.get_child_count() >= 4, "TAS screen must explain its single-match format and regional qualification requirements")
	hub._show_modes()
	var catalog_requests := [0]
	hub.catalog_requested.connect(func(): catalog_requests[0] += 1)
	var legend_panel: Control = hub.content_box.get_child(1)
	var legend_row: Control = legend_panel.get_child(0)
	var legend_button: Button = legend_row.get_child(1)
	assert(legend_button.text.contains("VER MÓDULO") and legend_button.text.begins_with("⬇"), "Legend must show a download icon and remain a module, not a base-game mode")
	legend_button.pressed.emit()
	assert(catalog_requests[0] == 1, "Selecting a mode must open the downloadable module catalogue")
	hub._request_catalog()
	assert(catalog_requests[0] == 2, "Catalog action must emit integration signal")
	hub._show_new_game_menu()
	assert(hub.current_subpage == "new_game" and hub.current_page == "home", "New Game must open a mode selection from Home")
	assert(hub.content_box.get_child_count() >= 3, "New Game must offer Manager, Legend and a return action")
	hub._show_league_browser()
	assert(hub.current_subpage == "league_browser", "Leagues and Cups must open the playable competition browser")
	assert(hub.content_box.get_child_count() >= 2, "Competition browser must show competitions and download catalog access")
	var football_data: Node = root.get_node_or_null("FootballData")
	assert(football_data != null, "FootballData autoload must be available in the game test")
	var competition_ids: Array = football_data.registry.competitions_by_id.keys()
	if not competition_ids.is_empty():
		hub._show_competition_detail(str(competition_ids[0]))
		assert(hub.current_subpage == "competition:" + str(competition_ids[0]), "Competition detail must open its league table and calendar")
	hub._open_legend_career()
	assert(hub.current_subpage == "legend_career", "Legend mode must open its player career")
	assert(hub.content_box.get_child_count() == 4, "Legend must first offer the two player-entry modes")
	var create_option := hub.content_box.get_child(1) as Control
	var choose_option := hub.content_box.get_child(2) as Control
	var create_button := create_option.get_child(0).get_child(1) as Button
	var choose_button := choose_option.get_child(0).get_child(1) as Button
	assert(create_button.text == "SELECCIONAR", "Create Player option must be available")
	assert(choose_button.text == "SELECCIONAR", "Choose Player option must be available")
	hub._show_legend_creator()
	assert(hub.content_box.get_child_count() >= 8, "Create Player must open the complete player creator")
	hub._show_modes()
	var legend_source := FileAccess.open("res://scripts/legend/legend_career_service.gd", FileAccess.READ)
	assert(legend_source != null, "Legend career service must exist")
	var legend_code := legend_source.get_as_text()
	assert(legend_code.contains("func record_match") and legend_code.contains("func retire_player"), "Legend career must track matches and support retirement")
	assert(legend_code.contains("season_history"), "Legend career must preserve season-by-season statistics")
	var hub_source := FileAccess.open("res://scripts/ui/game_hub.gd", FileAccess.READ)
	assert(hub_source != null, "Game hub source must exist")
	var hub_code := hub_source.get_as_text()
	assert(hub_code.contains("ESTADÍSTICAS DE TODA LA CARRERA") and hub_code.contains("ESTADÍSTICAS DE LA TEMPORADA"), "Legend dashboard must show both seasonal and career statistics")
	assert(hub_code.contains("_confirm_legend_retirement"), "Retirement must require a confirmation dialog")
	assert(hub_code.contains("_add_legend_manager_transition"), "Retired players aged 20 or older must be offered the Manager transition")
	assert(hub_code.contains("func _show_legend_catalog") and hub_code.contains("func _start_selected_legend_catalog_player"), "Choose Player must open and start a Nova catalog player career")
	assert(hub_code.contains("CustomPlayerRoster.get_created_players()") and hub_code.contains("MIS JUGADORES CREADOS"), "Online must list only user-created players from the isolated roster")
	assert(hub_code.contains("CustomPlayerRoster.select_for_online") and hub_code.contains("JUGADOR PREPARADO"), "Online must persist an explicit custom-player selection")
	assert(hub_code.contains("NOVA-PLAYER-0035") and hub_code.contains("NO TIENES ACCESO"), "Anier must appear as an owner-restricted player in Legend")
	assert(hub_code.contains("NovaOwnerAccess.verify_owner_session") and hub_code.contains("_request_anier_owner_selection"), "Anier selection must verify the owner session")
	assert(hub_code.contains("choose.disabled = true") and hub_code.contains('Color("777f78")'), "Anier must be greyed out and disabled for non-owners")
	var owner_access_source := FileAccess.open("res://scripts/data/nova_owner_access_service.gd", FileAccess.READ)
	assert(owner_access_source != null, "Nova owner access service must exist")
	var owner_access_code := owner_access_source.get_as_text()
	assert(owner_access_code.contains("e2b76b60-09b4-4e01-a93f-00c9bd7e257e"), "Owner identity must match Nova Apps owner account")
	assert(owner_access_code.contains("NOVA_IDENTITY_NOT_INTEGRATED") and not owner_access_code.contains("supabase.co") and not owner_access_code.contains("/auth/v1/"), "Owner access must not depend on external authentication and must wait for NOVA native identity")
	var roster_source := FileAccess.open("res://scripts/data/custom_player_roster_service.gd", FileAccess.READ)
	assert(roster_source != null, "Custom player roster service must exist")
	var roster_code := roster_source.get_as_text()
	assert(roster_code.contains("custom_player_roster.json") and roster_code.contains("online_custom_player_selection.json"), "Custom players and Online selection must persist separately")
	assert(roster_code.contains('str(player.get("origin", "user_created")) != "user_created"'), "Nova catalog players must be rejected from the custom roster")
	hub._open_manager_career()
	assert(hub.current_subpage == "manager_career", "Manager mode must open its integrated career setup")
	hub._open_main_page("settings")
	assert(hub.current_page == "settings", "Settings main screen must open")
	assert(hub.content_box.get_child_count() == 11, "Settings must expose eleven categories")
	hub._open_settings_category("Controles")
	assert(hub.current_subpage == "Controles", "Controller settings subpage must open")
	hub._open_settings_category("Módulos")
	assert(hub.current_subpage == "Módulos", "Modules settings subpage must open")
	assert(hub.content_box.get_child_count() == 3, "Modules subpage must expose catalog action and back navigation")
	hub._show_training()
	assert(hub.current_page == "home", "Training remains a subpage of Home")
	assert(hub.current_subpage == "training", "Training subpage must open")
	assert(hub.content_box.get_child_count() == 4, "Training must expose four configured cards")
	hub.training_mode_selected.connect(_on_training_selected)
	hub._select_training_mode("penalty")
	assert(selected_mode == "penalty", "Training selection signal must emit selected mode")
	assert(not hub.root.visible, "Hub must close when entering an exercise")
	hub.open_home()
	assert(hub.root.visible and hub.current_page == "home", "Hub must reopen at Home")
	assert(hub.MAIN_PAGES.size() == 4, "Exactly four main screens must exist")
	assert(hub_code.contains("DOWNLOAD_ICON") and hub_code.contains("⬇"), "Downloadable content must display a download icon")
	var main_file := FileAccess.open("res://scripts/main.gd", FileAccess.READ)
	assert(main_file != null, "Main scene script must exist")
	var main_source := main_file.get_as_text()
	assert(main_source.contains('LOADING_SCREEN = preload("res://scripts/ui/loading_screen.gd")'), "Loading screen must be integrated into the main scene")
	assert(main_source.contains('loading_screen.set_progress(100.0, "Fútbol Nova está listo.")'), "Loading screen must complete after startup initialization")
	assert(main_source.contains("catalog_requested.connect(_open_download_catalog)"), "Hub catalog request must be connected to main scene")
	assert(main_source.contains("MomentsService.record_event(\"goal_scored\", 1)"), "Training goals must update daily Moments")
	assert(main_source.contains("TOUCH_CONTROLS") and main_source.contains("_create_touch_controls"), "Android touch controls must be integrated into the main scene")
	var loading_file := FileAccess.open("res://scripts/ui/loading_screen.gd", FileAccess.READ)
	assert(loading_file != null, "Nova loading screen must exist")
	var loading_code := loading_file.get_as_text()
	assert(loading_code.contains("func set_progress") and loading_code.contains("func complete"), "Loading screen must expose progress and completion methods")
	var touch_file := FileAccess.open("res://scripts/input/touch_controls.gd", FileAccess.READ)
	assert(touch_file != null, "Virtual touch controls script must exist")
	var touch_source := touch_file.get_as_text()
	assert(touch_source.contains("InputEventScreenTouch") and touch_source.contains("move_left") and touch_source.contains("shoot_ball"), "Touch controls must provide a joystick and match action buttons")
	assert(hub_code.contains("func _simulate_league_round") and hub_code.contains("FootballData.simulate_round"), "The competition browser must simulate and persist league rounds")
	assert(hub_code.contains("func _show_tas_competition") and hub_code.contains("FootballData.simulate_tas_fixture") and hub_code.contains("FootballData.advance_tas_edition"), "TAS screen must simulate single matches and advance tournament stages")
	assert(hub_code.contains("FootballData.draw_ceremony_requested.connect(_on_draw_ceremony_requested)"), "Game hub must listen to draw events from every competition service")
	assert(hub_code.contains("func _on_draw_ceremony_requested"), "Game hub must route competition draw events into the ceremony")
	assert(hub_code.contains("func _show_national_team_tournaments") and hub_code.contains("NationalTeamCompetitions.get_all_competitions()"), "The national team tournament module must have a dedicated browser")
	assert(hub_code.contains("national_tournaments") and hub_code.contains("LIGAS Y COPAS"), "The modes menu must expose separate club and national-team competition entries")
	assert(hub_code.contains("europe") and hub_code.contains("africa") and hub_code.contains("asia") and hub_code.contains("oceania"), "The international club browser must display every world region")

	var service_file := FileAccess.open("res://scripts/data/football_data_service.gd", FileAccess.READ)
	assert(service_file != null, "Football data service must exist")
	var service_code := service_file.get_as_text()
	assert(service_code.contains("func _fixtures_to_draw_presentation") and service_code.contains("func _pairings_to_draw_presentation"), "Competition services must convert existing pairings into ceremony entries")
	assert(service_code.contains("func create_american_regional_champions_edition") and service_code.contains("_emit_competition_draw"), "Regional competitions must emit their resolved draw")
	assert(service_code.contains('_emit_competition_draw("Copa de Cuba"') and service_code.contains('_emit_competition_draw("Supercopa de Cuba"'), "Domestic cup and supercup draws must use the same ceremony")
	assert(service_code.contains("build_second_division_playoff") and service_code.contains("build_third_division_promotion_playoff"), "Promotion playoffs must publish their pairings")
	assert(service_code.contains("final_group_team_ids") and service_code.contains("Torneo Americano de Supercampeones (TAS) · Final"), "TAS progression draws must use the same ceremony")
	assert(service_code.contains("if not bool(response.get(\"ok\", false)):\n\t\treturn response\n\tvar saved: Dictionary = FootballDatabase.get_season_state(season_id)"), "Caribbean draw setters must stop on invalid draws before persistence")
	assert(service_code.contains("_emit_competition_draw(\"Liga de Campeones del Caribe · Octavos de final\"") and service_code.contains("_emit_competition_draw(\"Liga de Campeones del Caribe · \""), "Successful Caribbean knockout draws must open the common ceremony")
	assert(service_code.contains("draw_ceremony_requested.emit"), "Competition service must publish completed draw results")
	assert(service_code.contains("func publish_resolved_competition_draw"), "Custom tournaments must have a shared draw publication API")
	assert(hub_code.contains("for rank in range(table.size())"), "Competition details must display the full standings table")
	assert(hub_code.contains("func _start_next_league_season") and hub_code.contains("FootballData.start_next_season_for_stage"), "Finished leagues must allow a new saved season")
	assert(hub_code.contains("ManagerCareer.process_match(manager_match)") and hub_code.contains("_record_manager_league_results"), "Manager career objectives must receive results from the selected club's league")
	var project_file := FileAccess.open("res://project.godot", FileAccess.READ)
	assert(project_file != null and project_file.get_as_text().contains("MomentsService="), "Daily Moments service must be registered as autoload")
	assert(project_file.get_as_text().contains("LegendCareer="), "Legend career service must be registered as autoload")
	assert(project_file.get_as_text().contains("FootballDatabase="), "Persistent football database must be registered as an autoload")
	var football_database: Node = root.get_node_or_null("FootballDatabase")
	assert(football_database != null and bool(football_database.get("is_open")), "Persistent football database must open during startup")
	football_data.draw_ceremony_requested.emit("Sorteo de integración", [{"team_id": "test_club", "team_name": "Club de prueba", "opponent_team_id": "opponent_club", "group": "A", "round": "semifinals"}])
	await process_frame
	assert(hub.active_draw_ceremony != null and hub.active_draw_ceremony.visible, "A draw event from the competition service must open the skippable ceremony")
	assert(hub.active_draw_ceremony.skip_button.text == "SALTAR SORTEO", "The integrated ceremony must expose its skip button")
	hub.active_draw_ceremony.skip_draw()
	var revealed_row: PanelContainer = hub.active_draw_ceremony.result_list.get_child(0)
	var revealed_label: Label = revealed_row.get_child(0)
	assert(revealed_label.text.contains("Club de prueba") and revealed_label.text.contains("vs opponent_club") and revealed_label.text.contains("Semifinals"), "The ceremony must show both clubs and the competition round")
	hub.active_draw_ceremony.queue_free()
	await process_frame
	print("Futbol Nova game hub tests passed")
	quit(0)

func _on_training_selected(mode_id: String) -> void:
	selected_mode = mode_id
