extends SceneTree

const ANIER_SCENE: PackedScene = preload("res://scenes/players/anier_cumba.tscn")
const LegendService = preload("res://scripts/legend/legend_career_service.gd")

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	var file := FileAccess.open("res://data/custom_players.json", FileAccess.READ)
	assert(file != null, "custom_players.json must exist")
	var data: Dictionary = JSON.parse_string(file.get_as_text())
	assert(data.has("players") and data.players.size() > 0)
	var player: Dictionary = data.players[0]
	assert(player.id == "NOVA-PLAYER-0035")
	assert(player.name == "Anier Cumbá")
	assert(player.full_name == "Anier Alejandro Cumbá Ibar")
	assert(player.display_name == "Anier Cumbá")
	assert(player.date_of_birth == "2001-04-14")
	assert(player.birth_country == "CUB")
	assert(player.preferred_national_team == "BRA")
	assert(player.favorite_club == "Real Madrid")
	assert(player.height_cm == 171)
	assert(player.weight_kg == 65)
	assert(player.nationality == "CUB")
	assert(player.shirt_name == "CUMBÁ")
	assert(player.shirt_number == 35)
	assert(player.team_role == "captain")
	assert(player.preferred_foot == "right")
	assert(player.club_name == "Albor Madrid", "Anier plays for the fictional Real Madrid representative club")
	assert(player.favorite_club == "Real Madrid", "The representative club keeps its real-world reference separate")
	assert(player.overall == 92, "Anier's confirmed overall must be 92")
	assert(player.potential == 97, "Anier potential must be 97")
	assert(player.confirmed_attributes.acc == 90, "Anier base acceleration must be 90")
	assert(player.confirmed_attributes.spd == 90, "Anier base top speed must be 90")
	assert(player.confirmed_attributes.fin == 87, "Anier finishing must be 87")
	assert(player.confirmed_attributes.shot == 90, "Anier shot power must be 90")
	assert(player.confirmed_attributes == player.base_attributes, "All assigned base attributes are owner-confirmed")
	assert(player.base_attributes.acc == 90 and player.base_attributes.spd == 90)
	assert(player.attributes.acc == 98 and player.attributes.spd == 98)
	assert(player.attributes.agi == 92)
	assert(player.attribute_calculation.bonuses_included == true)
	var rating_service = LegendService.new()
	assert(rating_service.calculate_overall(player.attributes, "MCO") == 92, "Anier MCO overall must calculate to 92")
	rating_service.free()
	assert(player.preferred_national_team == "BRA")
	assert(player.visual.representation == "3D_ONLY")
	assert(player.visual.accessories.boots.base_color == "#C62828")
	assert(player.visual.accessories.boots.design_colors == ["#D4AF37", "#171923"])
	assert(player.visual.accessories.socks.kit_dependent == true)
	assert(player.visual.accessories.socks.length == "long")
	assert(player.visual.accessories.socks.description == "Medias largas que llegan por encima de las rodillas, siempre con los colores y el diseño de la equipación que lleve puesta.")
	assert(player.visual.kit.shirt_tucked == false)
	assert(player.visual.kit.shirt_fit == "untucked_over_shorts")
	assert(data.equipment_rules.shin_guards.required_for_all_players == true)
	assert(player.visual.accessories.shin_guards.required == true)
	assert(player.visual.accessories.wristbands.worn == false)
	assert(player.visual.accessories.hairband.worn == false)
	assert(player.visual.accessories.captain_armband.worn == true)
	assert(player.visual.accessories.captain_armband.kit_dependent == true)
	assert(player.visual.accessories.captain_armband.design_source == "current_team")
	assert(player.visual.accessories.gloves.worn == true)
	assert(player.visual.accessories.gloves.base_color == "#171923")
	assert(player.visual.accessories.gloves.design_colors == ["#C62828", "#D4AF37"])
	assert(player.visual.accessories.earrings.worn == false)
	assert(player.visual.accessories.inner_shirt.worn == true)
	assert(player.visual.accessories.inner_shirt.always_worn == true)
	assert(player.visual.accessories.inner_shirt.wear_policy == "all_matches_and_kits")
	assert(player.visual.accessories.inner_shirt.sleeve_length == "long")
	assert(player.visual.accessories.inner_shirt.fit == "compression")
	assert(player.visual.accessories.inner_shirt.fit_type == "snug")
	assert(player.visual.accessories.inner_shirt.kit_dependent == true)
	assert(player.visual.accessories.inner_shirt.style_reference == "EA SPORTS FIFA 23")
	assert(player.visual.accessories.inner_shirt.neckline_visible == true)
	assert(player.visual.accessories.inner_shirt.neckline_style == "around_neck")
	assert(player.position == "MCO")
	assert(player.secondary_positions.has("MC"))

	var anier := ANIER_SCENE.instantiate()
	assert(anier != null, "Anier's 3D scene must instantiate")
	root.add_child(anier)
	await process_frame
	assert(anier.get_script().resource_path.ends_with("anier_cumba.gd"))
	assert(anier.find_child("AnierVisual3D", true, false) != null)
	assert(anier.find_child("torso", true, false) != null)
	assert(anier.find_child("shirt_untucked_hem", true, false) != null)
	assert(anier.find_child("long_sock_1.0", true, false) != null)
	assert(anier.find_child("boot_1.0", true, false) != null)
	assert(anier.find_child("boot_sole_1.0", true, false) != null)
	assert(anier.find_child("boot_gold_design_1.0", true, false) != null)
	assert(anier.find_child("boot_black_design_1.0", true, false) != null)
	assert(anier.find_child("shin_guard_1.0", true, false) != null)
	assert(anier.find_child("glove_1.0", true, false) != null)
	assert(anier.find_child("inner_shirt_sleeve_1.0", true, false) != null)
	assert(anier.find_child("inner_shirt_neckline", true, false) != null)
	assert(anier.find_child("glove_red_detail_1.0", true, false) != null)
	assert(anier.find_child("glove_gold_detail_1.0", true, false) != null)
	assert(anier.find_child("captain_armband", true, false) != null)
	assert(anier.find_child("CollisionShape3D", true, false) != null)
	assert(is_equal_approx(float(anier.get("player_height_m")), 1.71))

	var main_file := FileAccess.open("res://scripts/main.gd", FileAccess.READ)
	assert(main_file != null)
	var main_source := main_file.get_as_text()
	assert(main_source.contains('preload("res://scenes/players/anier_cumba.tscn")'))
	assert(main_source.contains("ANIER_PLAYER_SCENE.instantiate()"))

	anier.queue_free()
	print("Anier Cumba profile and scene integration: PASS")
	quit(0)
