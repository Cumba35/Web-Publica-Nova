extends SceneTree

func _initialize() -> void:
	var service = load("res://scripts/moments/daily_moments_service.gd")
	assert(service != null, "Moments service must load")
	var state: Dictionary = service.create_daily_state("2026-11-14", 25)
	assert(int(state.get("progress", -1)) == 0, "Daily challenge starts at zero")
	var premature: Dictionary = service.claim_reward_from_state(state)
	assert(not bool(premature.get("ok", false)), "Reward cannot be claimed before completion")
	var progressed: Dictionary = service.apply_event_to_state(state, "goal_scored", 1)
	assert(int(progressed.get("progress", 0)) == 1, "Matching event must advance challenge")
	var completed: Dictionary = service.apply_event_to_state(progressed, "goal_scored", 99)
	assert(int(completed.get("progress", 0)) == int(completed.get("target", 0)), "Progress must clamp at target")
	var claimed: Dictionary = service.claim_reward_from_state(completed)
	assert(bool(claimed.get("ok", false)), "Completed challenge must be claimable")
	var claimed_state: Dictionary = claimed.get("state", {})
	assert(bool(claimed_state.get("claimed", false)), "Claim must be recorded")
	assert(int(claimed_state.get("total_points", 0)) == 25 + int(claimed.get("reward", 0)), "Reward points must accumulate")
	var duplicate: Dictionary = service.claim_reward_from_state(claimed_state)
	assert(not bool(duplicate.get("ok", false)), "Reward must not be claimable twice")
	var ignored: Dictionary = service.apply_event_to_state(claimed_state, "goal_scored", 1)
	assert(int(ignored.get("progress", 0)) == int(claimed_state.get("progress", 0)), "Claimed challenge must not keep progressing")
	print("Daily Moments service tests passed")
	quit(0)
